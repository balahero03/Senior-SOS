// backend/prisma/schema.prisma
// Source of truth: PostgreSQL schema from SeniorSOS Database Schema & Integration Design PDF.
//
// IMPORTANT: Prisma cannot express partial or expression indexes.
// The following must be kept in the migration SQL manually:
//   - uq_pending_connection_pair  (connection_requests, partial WHERE status = 'PENDING')
//   - uq_open_mentorship          (mentorship_requests,  partial WHERE status IN ('PENDING','ACTIVE'))
//   - idx_connections_unsynced    (connections,          partial WHERE graph_synced_at IS NULL)
// These are added in: prisma/migrations/20261010000000_init/migration.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ALUMNI
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("verification_status")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("request_status")
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
  ENDED

  @@map("mentorship_status")
}

enum MentorshipFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY

  @@map("mentorship_frequency")
}

// ─── Core identity ────────────────────────────────────────────────────────────

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String        @db.VarChar(150)
  email           String        @unique @db.VarChar(255)
  passwordHash    String        @map("password_hash")
  role            UserRole      @default(STUDENT)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  academicProfile AcademicProfile?
  alumniProfile   AlumniProfile?
  userSkills      UserSkill[]

  sentConnectionRequests     ConnectionRequest[] @relation("SentRequests")
  receivedConnectionRequests ConnectionRequest[] @relation("ReceivedRequests")
  connectionsAsA             Connection[]        @relation("UserAConnections")
  connectionsAsB             Connection[]        @relation("UserBConnections")

  mentorshipsAsMentee MentorshipRequest[] @relation("MenteeRequests")
  mentorshipsAsMentor MentorshipRequest[] @relation("MentorRequests")

  receivedNotifications Notification[] @relation("RecipientNotifications")
  actorNotifications    Notification[] @relation("ActorNotifications")

  userSettings  UserSettings?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

// ─── Academic structure ───────────────────────────────────────────────────────

model Department {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String            @unique @db.VarChar(20)
  name             String            @unique @db.VarChar(150)
  academicProfiles AcademicProfile[]

  @@map("departments")
}

// One row per student and alumnus (shared academic info).
model AcademicProfile {
  userId          String  @id @map("user_id") @db.Uuid
  departmentId    String  @map("department_id") @db.Uuid
  graduationYear  Int     @map("graduation_year") @db.SmallInt
  bio             String?
  careerInterests String? @map("career_interests")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId, graduationYear], map: "idx_academic_department_year")
  @@map("academic_profiles")
}

// ─── Companies (normalised) ───────────────────────────────────────────────────

// One row per real company. Upsert by name_key = lower(trim(name)).
model Company {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String @db.VarChar(200)
  nameKey String @unique @map("name_key") @db.VarChar(200)

  alumniProfiles AlumniProfile[]

  @@map("companies")
}

// Alumni-specific fields only. ADMIN has no profile rows.
model AlumniProfile {
  userId             String             @id @map("user_id") @db.Uuid
  companyId          String?            @map("company_id") @db.Uuid
  designation        String?            @db.VarChar(200)
  experienceYears    Decimal?           @map("experience_years") @db.Decimal(4, 1)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "idx_alumni_company")
  @@map("alumni_profiles")
}

// ─── Skills ───────────────────────────────────────────────────────────────────

model Skill {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @unique @db.VarChar(100)
  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  userId      String  @map("user_id") @db.Uuid
  skillId     String  @map("skill_id") @db.Uuid
  proficiency String? @db.VarChar(30)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("user_skills")
}

// ─── Connections ──────────────────────────────────────────────────────────────

model ConnectionRequest {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId   String        @map("sender_id") @db.Uuid
  receiverId String        @map("receiver_id") @db.Uuid
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Restrict)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Restrict)

  // Partial unique index uq_pending_connection_pair is in migration.sql (Prisma cannot express it)
  @@index([senderId, status], map: "idx_conn_req_sender_status")
  @@index([receiverId, status], map: "idx_conn_req_receiver_status")
  @@map("connection_requests")
}

// One row per accepted connection in canonical order (user_a < user_b).
model Connection {
  userA         String    @map("user_a") @db.Uuid
  userB         String    @map("user_b") @db.Uuid
  connectedAt   DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  // NULL = not yet mirrored to Neo4j
  graphSyncedAt DateTime? @map("graph_synced_at") @db.Timestamptz(6)

  userARelation User @relation("UserAConnections", fields: [userA], references: [id], onDelete: Restrict)
  userBRelation User @relation("UserBConnections", fields: [userB], references: [id], onDelete: Restrict)

  // Partial index idx_connections_unsynced is in migration.sql
  @@id([userA, userB])
  @@index([userB], map: "idx_connections_user_b")
  @@map("connections")
}

// ─── Mentorship ───────────────────────────────────────────────────────────────

// Request and active relationship lifecycle in one table.
// Partial unique index uq_open_mentorship is in migration.sql.
model MentorshipRequest {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menteeId        String              @map("mentee_id") @db.Uuid
  mentorId        String              @map("mentor_id") @db.Uuid
  focusArea       String              @map("focus_area") @db.VarChar(150)
  helpDescription String?             @map("help_description")
  goals           String?
  frequency       MentorshipFrequency @default(ONE_TIME)
  status          MentorshipStatus    @default(PENDING)
  // Set when status → ACTIVE; cleared by CHECK constraint if not ACTIVE/ENDED
  startedAt       DateTime?           @map("started_at") @db.Timestamptz(6)
  // Set when status → ENDED
  endedAt         DateTime?           @map("ended_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentee User @relation("MenteeRequests", fields: [menteeId], references: [id], onDelete: Restrict)
  mentor User @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Restrict)

  @@index([mentorId, status], map: "idx_mentorship_mentor_status")
  @@index([menteeId, status], map: "idx_mentorship_mentee_status")
  @@map("mentorship_requests")
}

// ─── Supporting tables ────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  type        String    @db.VarChar(50)
  payload     Json      @default("{}")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient User  @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt(sort: Desc)], map: "idx_notifications_recipient_created")
  @@map("notifications")
}

model UserSettings {
  userId                  String   @id @map("user_id") @db.Uuid
  // CHECK (profile_visibility IN ('COLLEGE','CONNECTIONS_ONLY')) enforced in migration.sql
  profileVisibility       String   @default("COLLEGE") @map("profile_visibility") @db.VarChar(30)
  notificationPreferences Json     @default("{\"connection_requests\":true,\"messages\":true,\"mentorship_requests\":true,\"community_activity\":false}") @map("notification_preferences")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_actor_created")
  @@map("audit_logs")
}
