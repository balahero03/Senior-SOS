# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── PostgreSQL (via Prisma) ─────────────────────────────────────────────────
# For cloud PostgreSQL (Neon / Supabase / Railway):
DATABASE_URL="postgresql://neondb_owner:npg_REaLsZu34OGr@ep-raspy-voice-azoi2ppi-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:npg_REaLsZu34OGr@ep-raspy-voice-azoi2ppi-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── MongoDB (Social Content & Chat) ──────────────────────────────────────────
# For MongoDB Atlas Cloud: mongodb+srv://user:pass@cluster.mongodb.net/seniorsos?retryWrites=true&w=majority
# For local Docker Compose: mongodb://localhost:27018/seniorsos
MONGODB_URI="mongodb://localhost:27018/seniorsos"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Refresh token TTL in milliseconds (7 days)
REFRESH_TOKEN_TTL_MS=604800000

# ─── Cookies ─────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ─── CORS ────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ─── API transcript logging ───────────────────────────────────────────────────
# Writes full request/response bodies to backend/logs/api-<date>.txt.
# Bodies are NOT redacted, so logs/ is gitignored. Never enable in production.
API_TRANSCRIPT_LOG=true

# ─── Neo4j Aura (graph: mutual connections, paths, suggestions) ──────────────
# From the Aura console: create a free instance, then copy the connection URI
# and the generated password. Leave NEO4J_URI empty to disable graph features.
# URI looks like: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
