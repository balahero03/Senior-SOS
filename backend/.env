# Local development configuration. Copy backend/.env.example to restore defaults.
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://seniorsos_user:seniorsos_pass@localhost:5433/seniorsos?schema=public"
DIRECT_URL="postgresql://seniorsos_user:seniorsos_pass@localhost:5433/seniorsos?schema=public"
MONGODB_URI="mongodb://localhost:27018/seniorsos"
JWT_ACCESS_SECRET=local_development_only_replace_before_deployment
JWT_REFRESH_SECRET=local_development_only_replace_before_deployment
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_MS=604800000
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CLIENT_ORIGIN=http://localhost:5173
