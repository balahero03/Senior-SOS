# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── PostgreSQL (via Prisma) ─────────────────────────────────────────────────
# For local Docker Compose:
DATABASE_URL="postgresql://postgres:hsDQbbcOScly1R4m@db.bggipvilvbemaepwgugq.supabase.co:5432/postgres"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a long random secret in production: openssl rand -base64 64
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Refresh token TTL in milliseconds (7 days)
REFRESH_TOKEN_TTL_MS=604800000

# ─── Cookies ─────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ─── CORS ────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
