# Copy to .env for local development. These local database values match docker-compose.yml.
NODE_ENV=development
PORT=5000

# PostgreSQL via Prisma
DATABASE_URL="postgresql://seniorsos_user:seniorsos_pass@localhost:5433/seniorsos?schema=public"
DIRECT_URL="postgresql://seniorsos_user:seniorsos_pass@localhost:5433/seniorsos?schema=public"

# MongoDB
MONGODB_URI="mongodb://localhost:27018/seniorsos"

# Replace with long random values before exposing this server beyond local development.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_MS=604800000

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CLIENT_ORIGIN=http://localhost:5173

# ─── API transcript logging ───────────────────────────────────────────────────
# true writes every API request and response to backend/logs/api-<date>.txt.
# Bodies are recorded verbatim (passwords and tokens included), so logs/ is
# gitignored and this is ignored entirely when NODE_ENV=production.
# Read them with: npm run logs -- --help
API_TRANSCRIPT_LOG=false
